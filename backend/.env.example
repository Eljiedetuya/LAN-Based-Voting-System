# COPY TO backend/.env AND REPLACE ALL PLACEHOLDERS. NEVER COMMIT backend/.env.
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=True
# Use localhost for local development. Add the server LAN IP for an authorized LAN test.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# LAN HTTPS deployment requires separate proxy/certificate and secure cookie settings.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
MYSQL_DATABASE=lan_voting
MYSQL_USER=lan_voting_app
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
